{
  "name": "sig-dep-backend",
  "version": "1.1.0",
  "description": "API REST du SIG-DEP — Système Intégré de Gestion de la Direction d’Études et Planification",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src src/server.js",
    "start": "node src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback --all",
    "migrate:status": "knex migrate:status",
    "seed": "knex seed:run",
    "db:reset": "knex migrate:rollback --all && knex migrate:latest && knex seed:run",
    "reset-admin": "node scripts/reset-admin.js",
    "backup": "bash scripts/backup.sh",
    "test": "cross-env NODE_ENV=test jest --runInBand"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.7.2",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/globalSetup.js",
    "testTimeout": 30000,
    "setupFilesAfterEnv": [
      "./tests/setupAfterEnv.js"
    ]
  }
}
