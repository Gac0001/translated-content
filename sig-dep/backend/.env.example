# ─────────────────────────────────────────────────────────────
# SIG-DEP — Direction d’Études et Planification (DEP)
# Fichier d’exemple : copier en .env puis adapter les valeurs.
# Ne jamais versionner le fichier .env.
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgres://sigdep:sigdep@localhost:5432/sig_dep
DATABASE_URL_TEST=postgres://sigdep:sigdep@localhost:5432/sig_dep_test

# Jetons (générer des valeurs longues et aléatoires en production :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=remplacer-par-un-secret-long-et-aleatoire-acces
# Clé de chiffrement des secrets de double authentification (facultative : dérivée de JWT_ACCESS_SECRET).
# Ne la changez pas après la mise en service : les comptes devraient reconfigurer leur 2FA.
# TOTP_ENC_KEY=

# ─── Sauvegardes ─────────────────────────────────────────────────────────────
# Clé de chiffrement des sauvegardes (phrase longue et aléatoire). CONSERVEZ-LA HORS LIGNE
# (papier sous scellé, coffre) : sans elle, aucune sauvegarde chiffrée ne peut être restaurée.
# BACKUP_ENC_KEY=
# Copie de chaque sauvegarde hors du serveur (disque externe, partage réseau monté), ex. :
# BACKUP_COPY_DIR=/mnt/sauvegardes-dep        (Windows : E:/sauvegardes-dep)
# PG_RESTORE_PATH=pg_restore
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# CORS : origines autorisées séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# Cookie du refresh token (true en production derrière HTTPS)
COOKIE_SECURE=false

# Sécurité de connexion
MAX_FAILED_LOGINS=5
LOCK_DURATION_MINUTES=15
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=20

# Fichiers
UPLOAD_DIR=./storage/uploads
BACKUP_DIR=./storage/backups
MAX_UPLOAD_MB=15

# Présences : verrouillage automatique (heures) des listes soumises
PRESENCE_AUTOLOCK_HOURS=24

# Données de démonstration (agents, comptes de test) lors du seed
SEED_DEMO=true

# Chemin de pg_dump si non présent dans le PATH (ex. Windows)
# PG_DUMP_PATH="C:/Program Files/PostgreSQL/16/bin/pg_dump.exe"

# ─── Notifications par e-mail ───────────────────────────────────────────────
# Désactivées par défaut. Renseigner le serveur SMTP de l’administration puis MAIL_ENABLED=true.
MAIL_ENABLED=false
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.exemple.cd
SMTP_PORT=587
# true pour le port 465 (TLS implicite) ; false pour 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Mettre false uniquement pour un serveur interne à certificat auto-signé
SMTP_TLS_REJECT_UNAUTHORIZED=true
MAIL_FROM="SIG-DEP — Direction d’Études et Planification <no-reply@exemple.cd>"
# Adresse publique de l’interface (liens dans les e-mails)
APP_URL=http://localhost:5173
# Adresse publique de la page de vérification des cartes de service (encodée dans le QR code).
# Par défaut : APP_URL. À fixer avant l’impression des premières cartes (le QR code ne change plus ensuite).
# PUBLIC_URL=https://sig-dep.numerique.gouv.cd
MAIL_MAX_ATTEMPTS=5
