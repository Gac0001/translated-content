# ─────────────────────────────────────────────────────────────
# SIG-DEP — configuration du serveur (commune à toutes les versions installées)
# Créé par l’installateur à la première installation ; les secrets ont été générés pour ce serveur.
# Ce fichier ne doit jamais être copié sur un autre poste ni envoyé par messagerie.
# Après toute modification : redémarrer le service, puis « npm run verifier-production ».
# ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ─── À COMPLÉTER ────────────────────────────────────────────────────────────
# Base PostgreSQL dédiée (utilisateur propre, mot de passe fort, port 5432 fermé au réseau)
DATABASE_URL=postgres://sigdep:MOT-DE-PASSE-A-RENSEIGNER@localhost:5432/sig_dep
# Adresse par laquelle les agents ouvrent l’application (nom ou adresse IP du serveur sur le réseau)
APP_URL=http://ADRESSE-DU-SERVEUR:4000
# Adresse de la page de vérification encodée dans le QR code des cartes de service :
# à fixer AVANT d’imprimer les premières cartes (elle ne change plus ensuite).
# PUBLIC_URL=http://ADRESSE-DU-SERVEUR:4000

# ─── Service unique : l’API sert aussi l’interface, sur le même port ────────
FRONTEND_DIR=../frontend/dist
# Aucun proxy inverse devant l’API : l’adresse IP vue est celle du poste (mettre 1 derrière Nginx ou IIS)
TRUST_PROXY=0
CORS_ORIGINS=http://ADRESSE-DU-SERVEUR:4000

# ─── HTTPS (recommandé dès qu’un certificat est disponible) ─────────────────
# Certificat interne servi directement par l’API ; puis APP_URL en https:// et COOKIE_SECURE=true.
# TLS_CERT_FILE={{RACINE}}/config/certificat.pem
# TLS_KEY_FILE={{RACINE}}/config/cle-privee.pem
# HTTP_REDIRECT_PORT=80
COOKIE_SECURE=false

# ─── Secrets générés pour ce serveur ────────────────────────────────────────
JWT_ACCESS_SECRET={{JWT_ACCESS_SECRET}}
# Clé de chiffrement des sauvegardes : NOTEZ-LA HORS LIGNE (papier sous scellé, coffre).
# Sans elle, aucune sauvegarde ne peut être restaurée, y compris sur un nouveau serveur.
BACKUP_ENC_KEY={{BACKUP_ENC_KEY}}
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ─── Fichiers (hors des dossiers de version : conservés lors des mises à jour) ─
UPLOAD_DIR={{RACINE}}/donnees/pieces
BACKUP_DIR={{RACINE}}/donnees/sauvegardes
# Copie de chaque sauvegarde hors du serveur (disque externe, partage réseau) — vivement recommandé
# BACKUP_COPY_DIR=E:/SIG-DEP-sauvegardes
MAX_UPLOAD_MB=15
# Outils PostgreSQL s’ils ne sont pas dans le PATH (Windows) :
# PG_DUMP_PATH=C:/Program Files/PostgreSQL/16/bin/pg_dump.exe
# PG_RESTORE_PATH=C:/Program Files/PostgreSQL/16/bin/pg_restore.exe

# ─── Sécurité de connexion ──────────────────────────────────────────────────
MAX_FAILED_LOGINS=5
LOCK_DURATION_MINUTES=15
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=20
PRESENCE_AUTOLOCK_HOURS=24

# Pas de données de démonstration en production
SEED_DEMO=false

# ─── Messagerie (à activer quand le serveur SMTP du Ministère sera disponible) ─
MAIL_ENABLED=false
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.exemple.cd
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TLS_REJECT_UNAUTHORIZED=true
MAIL_FROM="SIG-DEP — Direction d’Études et Planification <no-reply@exemple.cd>"
MAIL_MAX_ATTEMPTS=5
