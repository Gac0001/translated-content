# SIG-DEP — Interface web de la Direction d’Études et Planification
# Préfixe des appels API (laisser /api : Vite relaie vers le backend en développement,
# et le serveur web (Nginx/IIS) le fait en production).
VITE_API_URL=/api
# Adresse du backend utilisée par le proxy de développement
VITE_BACKEND_URL=http://localhost:4000
# Déconnexion automatique après inactivité (minutes ; 0 pour désactiver)
VITE_INACTIVITY_MINUTES=30
